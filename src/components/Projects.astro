---
import { featuredProjects, otherProjects } from '../data/projects';
---

<section id="projects" class="py-20 sm:py-28 border-b border-[#eddde6]/70">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-14 sm:mb-20">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#19141e]">
        Featured Projects
      </h2>
      <p class="mt-2 text-base sm:text-lg text-[#595261] font-body max-w-2xl leading-relaxed">
        Featured applications and desktop utilities built in 2026.
      </p>
    </div>

    <!-- Pinned Split-Screen Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-12 lg:gap-12 relative">
      
      <!-- Left Column: Sticky Pinned Device Mockup Frame (Desktop Only) -->
      <div class="hidden lg:block lg:col-span-5">
        <div class="sticky top-24 self-start h-[calc(100vh-7.5rem)] flex flex-col justify-center">
          <!-- Clean Pinned Image Frame (Without Redundant Header Status) -->
          <div class="bg-white rounded-2xl border border-[#eddde6] shadow-soft p-2.5 relative aspect-[16/11] overflow-hidden group">
            {featuredProjects.map((project, idx) => (
              <div
                id={`pinned-slide-${idx}`}
                class={`absolute inset-2.5 rounded-xl overflow-hidden bg-[#faf8f9] transition-all duration-500 ease-out ${
                  idx === 0 ? 'opacity-100 scale-100 z-10 pointer-events-auto' : 'opacity-0 scale-98 z-0 pointer-events-none'
                }`}
              >
                {project.image ? (
                  <img
                    src={project.image}
                    alt={`Screenshot of ${project.title}`}
                    class="w-full h-full object-cover object-top"
                    loading={idx === 0 ? 'eager' : 'lazy'}
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center font-mono text-xs text-[#827a8c]">
                    {project.title}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Scrolling Narrative Stream (7 cols) -->
      <div class="lg:col-span-7 space-y-24 sm:space-y-32 py-4">
        {featuredProjects.map((project, index) => (
          <article
            class="project-stream-item flex flex-col justify-between"
            data-project-index={index}
            data-project-title={project.title}
          >
            <div>
              <!-- Category & Year Meta Line -->
              <div class="flex items-center gap-2 text-xs font-mono text-[#827a8c] mb-1.5">
                <span class="text-[#c23373] font-medium">{project.category}</span>
                <span>·</span>
                <span>{project.year}</span>
              </div>

              <!-- Project Title -->
              <h3 class="text-2xl sm:text-3xl font-extrabold text-[#19141e] tracking-tight">
                <a
                  href={project.demoLink || project.repoLink || '#'}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#c23373] transition-colors inline-flex items-center gap-2"
                >
                  {project.title}
                </a>
              </h3>

              <!-- Role -->
              <div class="mt-1 text-xs font-mono text-[#827a8c]">
                Role: <span class="text-[#19141e] font-medium">{project.role}</span>
              </div>

              <!-- Mobile-Only Mockup Preview -->
              <div class="lg:hidden mt-5 rounded-xl overflow-hidden border border-[#eddde6] bg-[#faf8f9] aspect-[16/10] shadow-soft">
                {project.image && (
                  <img
                    src={project.image}
                    alt={`Screenshot of ${project.title}`}
                    class="w-full h-full object-cover object-top"
                    loading="lazy"
                  />
                )}
              </div>

              <!-- Overview Paragraph -->
              <p class="mt-4 text-sm sm:text-base text-[#595261] font-body leading-relaxed">
                {project.description}
              </p>

              <!-- Technical Highlights (Clean Dash Marker instead of Sales Checkmarks) -->
              {project.highlights && project.highlights.length > 0 && (
                <div class="mt-5">
                  <span class="block text-xs font-mono text-[#827a8c] uppercase tracking-wider mb-2">
                    Technical Highlights
                  </span>
                  <ul class="space-y-2 text-xs sm:text-sm text-[#595261] font-body">
                    {project.highlights.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <span class="text-[#827a8c] font-mono select-none mt-0.5 leading-none">—</span>
                        <span class="leading-relaxed">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Result (Quiet, integrated statement without bulky alert box) -->
              {project.impact && (
                <div class="mt-5 pl-3.5 border-l-2 border-[#d48aa8]">
                  <span class="block text-[11px] font-mono text-[#c23373] uppercase tracking-wider font-semibold mb-1">
                    Result
                  </span>
                  <p class="text-xs sm:text-sm text-[#19141e] font-body leading-relaxed">
                    {project.impact}
                  </p>
                </div>
              )}

              <!-- Technologies (Clean inline format instead of heavy pill blocks) -->
              <div class="mt-5 text-xs font-mono text-[#827a8c] leading-relaxed">
                <span class="text-[#19141e] font-medium">Stack:</span> {project.tech.join(' · ')}
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-6 pt-4 border-t border-[#eddde6]/70 flex flex-wrap items-center gap-2.5">
              {project.demoLink && (
                <a
                  href={project.demoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#19141e] text-white text-xs font-semibold hover:bg-[#c23373] transition-colors shadow-soft"
                >
                  <span>{project.actionLabel || 'Live Demo'}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              {project.repoLink && (
                <a
                  href={project.repoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-white border border-[#eddde6] text-[#19141e] text-xs font-semibold hover:border-[#d48aa8] hover:bg-[#fff0f6] transition-colors shadow-soft"
                >
                  <span>Source Code</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>

    </div>

    <!-- Other Projects -->
    <div class="mt-20 sm:mt-28 pt-12 border-t border-[#eddde6]/70">
      <div class="mb-8">
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-[#19141e]">
          Other Projects
        </h3>
        <p class="text-sm text-[#595261] font-body mt-1">
          Earlier client work, map navigation, and rental management systems.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {otherProjects.map((project) => (
          <article class="bg-white rounded-xl border border-[#eddde6] shadow-soft hover:shadow-soft-hover hover:border-[#d48aa8] transition-all duration-300 p-5 flex flex-col justify-between">
            <div>
              {project.image && (
                <div class="rounded-lg overflow-hidden border border-[#eddde6]/70 aspect-[16/10] mb-4 bg-[#faf8f9]">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-top"
                    loading="lazy"
                  />
                </div>
              )}

              <div class="flex items-center justify-between text-[11px] font-mono text-[#827a8c] mb-1.5">
                <span class="text-[#c23373] font-medium">{project.category}</span>
                <span>{project.year}</span>
              </div>

              <h4 class="text-base font-bold text-[#19141e]">
                {project.title}
              </h4>

              <p class="mt-2 text-xs text-[#595261] font-body leading-relaxed">
                {project.description}
              </p>

              <div class="mt-3 text-[11px] font-mono text-[#827a8c]">
                <span class="text-[#19141e]">Stack:</span> {project.tech.join(' · ')}
              </div>
            </div>

            <div class="mt-5 pt-3 border-t border-[#eddde6]/60">
              {project.demoLink ? (
                <a
                  href={project.demoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-semibold text-[#19141e] hover:text-[#c23373] transition-colors"
                >
                  <span>Live Site</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ) : project.repoLink ? (
                <a
                  href={project.repoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-semibold text-[#19141e] hover:text-[#c23373] transition-colors"
                >
                  <span>Source Code</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ) : null}
            </div>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- Client Script to Sync Pinned Window with Scrolling Stream -->
<script>
  function setupPinnedScrollSync() {
    const items = document.querySelectorAll('.project-stream-item');
    if (!items.length) return;

    let currentIndex = 0;

    function setActiveProject(index: number) {
      if (index === currentIndex) return;
      currentIndex = index;

      items.forEach((_, idx) => {
        const slide = document.getElementById(`pinned-slide-${idx}`);
        if (slide) {
          if (idx === index) {
            slide.classList.remove('opacity-0', 'scale-98', 'z-0', 'pointer-events-none');
            slide.classList.add('opacity-100', 'scale-100', 'z-10', 'pointer-events-auto');
          } else {
            slide.classList.remove('opacity-100', 'scale-100', 'z-10', 'pointer-events-auto');
            slide.classList.add('opacity-0', 'scale-98', 'z-0', 'pointer-events-none');
          }
        }
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idxStr = entry.target.getAttribute('data-project-index');
            if (idxStr !== null) {
              setActiveProject(parseInt(idxStr, 10));
            }
          }
        });
      },
      {
        rootMargin: '-30% 0px -40% 0px',
        threshold: 0.1,
      }
    );

    items.forEach((item) => observer.observe(item));
  }

  setupPinnedScrollSync();
</script>
