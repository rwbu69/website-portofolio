---
import { contactDetails } from '../../data/profile';
---

<section class="availability-card" aria-label="Availability">
  <div class="window-titlebar mono">
    <span class="availability-title">RWBU_AVAILABILITY.TXT</span>
    <div class="window-controls" aria-hidden="true">
      <span class="window-btn">_</span>
      <span class="window-btn">×</span>
    </div>
  </div>

  <div class="window-body availability-body">
    <div class="availability-label mono">CURRENT STATUS</div>
    <h2 class="availability-headline">Available for thoughtful work.</h2>
    <p class="availability-subhead">
      Web applications, desktop tools, and playful experiments.
    </p>

    <dl class="availability-details mono">
      <div>
        <dt>Status</dt>
        <dd>Open to selected projects</dd>
      </div>
      <div>
        <dt>Location</dt>
        <dd>Indonesia · UTC+7</dd>
      </div>
      <div>
        <dt>Reply time</dt>
        <dd>Usually within 24–48 hours</dd>
      </div>
    </dl>

    <div class="availability-actions">
      <a class="window-action-btn availability-btn-email mono" href={`mailto:${contactDetails.email}`}>
        Email me
      </a>
      <a class="window-action-btn availability-btn-gh mono" href={contactDetails.githubUrl} target="_blank" rel="noopener noreferrer">
        View GitHub
      </a>
    </div>
  </div>
</section>
