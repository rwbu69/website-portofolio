---
import { identity, contact } from '../data/profile';
---

<section id="contact" class="py-20 sm:py-28">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    
    <!-- Section Header (No 03 numbering) -->
    <div class="mb-12 sm:mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#19141e]">
        Contact
      </h2>
      <p class="mt-2 text-base sm:text-lg text-[#595261] font-body max-w-2xl leading-relaxed">
        Reach out via email or message for collaborations and project inquiries.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      
      <!-- Direct Communication -->
      <div class="bg-white rounded-2xl border border-[#eddde6] shadow-soft p-6 sm:p-8 flex flex-col justify-between">
        <div class="space-y-4">
          <!-- Email -->
          <div class="p-4 rounded-xl bg-[#faf8f9] border border-[#eddde6] flex items-center justify-between gap-3">
            <div class="min-w-0">
              <span class="block text-[11px] font-mono text-[#827a8c] uppercase tracking-wider">Email</span>
              <a
                href={`mailto:${contact.email}`}
                class="text-sm font-semibold text-[#19141e] hover:text-[#c23373] transition-colors truncate block mt-0.5"
              >
                {contact.email}
              </a>
            </div>
            <button
              type="button"
              id="copy-email-btn"
              data-email={contact.email}
              class="shrink-0 px-3 py-1.5 rounded-lg bg-white border border-[#eddde6] text-xs font-mono font-medium text-[#19141e] hover:border-[#d48aa8] hover:bg-[#fff0f6] transition-all cursor-pointer"
              title="Copy email address"
            >
              Copy
            </button>
          </div>

          <!-- WhatsApp -->
          <div class="p-4 rounded-xl bg-[#faf8f9] border border-[#eddde6] flex items-center justify-between gap-3">
            <div class="min-w-0">
              <span class="block text-[11px] font-mono text-[#827a8c] uppercase tracking-wider">WhatsApp</span>
              <span class="text-sm font-semibold text-[#19141e] truncate block mt-0.5">
                {contact.phone}
              </span>
            </div>
            <a
              href={contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 px-3 py-1.5 rounded-lg bg-[#19141e] text-white text-xs font-mono font-medium hover:bg-[#c23373] transition-colors inline-flex items-center gap-1 shadow-soft"
            >
              Message ↗
            </a>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#eddde6]/60 text-xs font-mono text-[#827a8c]">
          <span>Location: {identity.location}</span>
        </div>
      </div>

      <!-- Links & Profiles -->
      <div class="bg-white rounded-2xl border border-[#eddde6] shadow-soft p-6 sm:p-8 flex flex-col justify-between">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a
            href={contact.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-[#faf8f9] border border-[#eddde6] hover:border-[#d48aa8] hover:bg-[#fff0f6] transition-all group flex flex-col justify-between"
          >
            <span class="text-xs font-mono text-[#827a8c]">GitHub</span>
            <span class="text-sm font-bold text-[#19141e] group-hover:text-[#c23373] transition-colors mt-2 flex items-center justify-between">
              rwbu69 <span>↗</span>
            </span>
          </a>

          <a
            href={contact.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-[#faf8f9] border border-[#eddde6] hover:border-[#d48aa8] hover:bg-[#fff0f6] transition-all group flex flex-col justify-between"
          >
            <span class="text-xs font-mono text-[#827a8c]">LinkedIn</span>
            <span class="text-sm font-bold text-[#19141e] group-hover:text-[#c23373] transition-colors mt-2 flex items-center justify-between">
              Sebastian Vay <span>↗</span>
            </span>
          </a>

          <a
            href={contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-[#faf8f9] border border-[#eddde6] hover:border-[#d48aa8] hover:bg-[#fff0f6] transition-all group flex flex-col justify-between sm:col-span-2"
          >
            <span class="text-xs font-mono text-[#827a8c]">Instagram</span>
            <span class="text-sm font-bold text-[#19141e] group-hover:text-[#c23373] transition-colors mt-2 flex items-center justify-between">
              @shunshunrwbu <span>↗</span>
            </span>
          </a>
        </div>

        <div class="mt-6 pt-4 border-t border-[#eddde6]/60 text-xs font-mono text-[#827a8c]">
          <span>Western Indonesia Time (UTC+7)</span>
        </div>
      </div>

    </div>

    <!-- Footer Copyright -->
    <footer class="mt-20 pt-8 border-t border-[#eddde6] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[#827a8c]">
      <p>
        © {new Date().getFullYear()} {identity.name} ({identity.alias})
      </p>
      <p>
        Built with Astro & Lenis
      </p>
    </footer>

  </div>
</section>

<script>
  function setupCopyButton() {
    const copyBtn = document.getElementById('copy-email-btn');
    if (!copyBtn) return;

    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email');
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        const originalText = copyBtn.innerText;
        copyBtn.innerText = 'Copied!';
        copyBtn.classList.add('bg-[#fdf2f7]', 'text-[#c23373]', 'border-[#f8cfdf]');
        
        setTimeout(() => {
          copyBtn.innerText = originalText;
          copyBtn.classList.remove('bg-[#fdf2f7]', 'text-[#c23373]', 'border-[#f8cfdf]');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  }

  setupCopyButton();
</script>
