---
// src/components/Footer.astro
const buildDate = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<footer class="mt-auto py-4 border-t retro-border">
  <div class="max-w-4xl mx-auto px-6 flex justify-between items-center text-xs font-mono text-text-muted">
    <p>Last updated: {buildDate} | © {new Date().getFullYear()} RWBU</p>
    <div class="flex gap-4">
      <a href="https://www.linkedin.com/in/sebastianvyhutagalung/" target="_blank" rel="noopener noreferrer" class="hover:text-tosca hover:underline transition-colors">LinkedIn</a>
      <a href="https://www.instagram.com/shunshunrwbu" target="_blank" rel="noopener noreferrer" class="hover:text-tosca hover:underline transition-colors">Instagram</a>
      <a href="https://github.com/rwbu69" target="_blank" rel="noopener noreferrer" class="hover:text-tosca hover:underline transition-colors">GitHub</a>
    </div>
  </div>
</footer>
