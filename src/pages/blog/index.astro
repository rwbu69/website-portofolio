---
import RetroScreenLayout from '../../layouts/RetroScreenLayout.astro';
import { getPosts } from '../../lib/cms';

const posts = await getPosts();
---

<RetroScreenLayout title="RWBU | Weblog & Tech Notes" activeNav="blog">
  <div style="max-width: 1000px; margin: 0 auto; padding: 1.5vh 1vw;">
    <div style="border-bottom: 3px solid #d6336c; padding-bottom: 1.2vh; margin-bottom: 2vh;">
      <h2 style="font-size: 3.8vh; color: #a61e4d; text-decoration: underline; margin: 0 0 0.5vh 0;">
        RWBU's Weblog &amp; Notes
      </h2>
      <p style="font-size: 2.1vh; margin: 0.4vh 0; line-height: 1.4;">
        A personal collection of long-form articles, development logbooks, and technical observations on web frameworks, performance, and programming.
      </p>
    </div>

    <!-- Articles Table -->
    <table border="2" cellpadding="10" cellspacing="0" width="100%" class="facts" style="border: 3px solid #0b6e8a; width: 100%; border-collapse: collapse; background: #e0f4fa; font-size: 2vh;">
      <thead>
        <tr bgcolor="#cbeaf4" style="text-align: left; font-weight: bold; color: #0b6e8a; border-bottom: 2px solid #0b6e8a;">
          <th style="border: 2px solid #0b6e8a; padding: 8px 12px; width: 130px;" class="mono">Date</th>
          <th style="border: 2px solid #0b6e8a; padding: 8px 12px;">Article Details</th>
          <th style="border: 2px solid #0b6e8a; padding: 8px 12px; width: 110px; text-align: center;" class="mono">Action</th>
        </tr>
      </thead>
      <tbody>
        {posts.map((post) => (
          <tr style="background: #ffffff;">
            <td style="border: 2px solid #0b6e8a; padding: 10px 12px; vertical-align: top; font-weight: bold; color: #5b3a9e;" class="mono">
              {post.publishDate}
            </td>
            <td style="border: 2px solid #0b6e8a; padding: 10px 12px; vertical-align: top;">
              <a href={`/blog/${post.id}`} style="font-size: 2.4vh; font-weight: bold; color: #0b6e8a; display: block; margin-bottom: 4px; text-decoration: underline;">
                {post.title}
              </a>
              <p style="margin: 0 0 8px 0; font-size: 1.9vh; line-height: 1.35; color: #222222;">
                {post.excerpt}
              </p>
              {post.tags && post.tags.length > 0 && (
                <div style="display: flex; flex-wrap: wrap; gap: 6px;" class="mono">
                  {post.tags.map((tag: string) => (
                    <span style="padding: 2px 6px; background: #e6f7ec; border: 1px solid #1b7a3a; color: #1b7a3a; font-size: 1.6vh; font-weight: bold;">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </td>
            <td style="border: 2px solid #0b6e8a; padding: 10px 12px; vertical-align: middle; text-align: center;" class="mono">
              <a href={`/blog/${post.id}`} style="display: inline-block; padding: 4px 10px; border: 3px outset #0b6e8a; background: #ffffff; color: #0b6e8a; font-weight: bold; text-decoration: none; font-size: 1.8vh;">
                [ Read -&gt; ]
              </a>
            </td>
          </tr>
        ))}

        {posts.length === 0 && (
          <tr>
            <td colspan="3" style="border: 2px solid #0b6e8a; padding: 24px; text-align: center; color: #a61e4d;" class="mono">
              No weblog posts published yet. Check back soon!
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</RetroScreenLayout>
