---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts } from '../../lib/cms';

const posts = await getPosts();
---

<Layout title="RWBU | Blog & Notes">
  <Navbar />
  
  <main class="max-w-4xl mx-auto px-6 py-12 w-full flex-grow">
    <PageHeader 
      title="Blog & Notes" 
      description="A collection of notes, tutorials, and explorations related to web development and technology." 
    />

    <div class="space-y-6">
      {posts.map((post) => (
        <article class="p-5 bg-white border border-gray-200 hover:border-pink transition-colors group rounded-sm shadow-sm">
          <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-2">
            <time class="text-sm font-sans text-text-muted shrink-0 w-32">
              {post.publishDate}
            </time>
            <h2 class="text-xl font-bold group-hover:text-pink transition-colors">
              <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 relative">{post.title}</a>
            </h2>
          </div>
          
          <p class="text-sm text-text-main mb-4 md:ml-36">
            {post.excerpt}
          </p>
          
          {post.tags && post.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 md:ml-36">
              {post.tags.map((tag: string) => (
                <span class="text-xs font-sans px-2 py-0.5 bg-gray-50 border border-gray-200 text-text-muted rounded-sm">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
      
      {posts.length === 0 && (
        <div class="text-center py-12 text-text-muted font-sans">
          No posts found.
        </div>
      )}
    </div>
  </main>
</Layout>
