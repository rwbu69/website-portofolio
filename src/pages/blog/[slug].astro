---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`RWBU | ${post.data.title}`}>
  <Navbar />
  
  <main class="max-w-[75ch] mx-auto px-6 py-12 w-full grow">
    <a href="/blog" class="inline-flex items-center gap-2 text-sm font-mono text-text-muted hover:text-pink transition-colors mb-8">
      &lt;- Back to blogs
    </a>

    <header class="mb-12">
      <div class="flex items-center gap-4 text-xs font-mono text-text-muted mb-6">
        <span>{post.data.publishDate}</span>
        <span class="text-gray-300">|</span>
        <span>{post.data.readingTime}</span>
      </div>
      
      <h1 class="text-3xl md:text-4xl font-bold mb-6 tracking-tight leading-tight text-text-main font-serif">
        {post.data.title}
      </h1>
      
      <div class="flex flex-wrap gap-2 pb-8 border-b border-gray-300">
        {post.data.tags.map((tag: string) => (
          <span class="text-xs font-mono px-2 py-0.5 bg-gray-50 border border-gray-200 text-text-muted">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <article class="prose prose-slate max-w-none 
      prose-headings:font-bold prose-headings:font-sans prose-headings:tracking-tight 
      prose-a:text-pink hover:prose-a:text-tosca prose-a:transition-colors prose-a:no-underline hover:prose-a:underline
      prose-code:text-pink prose-code:bg-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded-sm prose-code:font-mono
      prose-pre:bg-gray-100 prose-pre:border prose-pre:border-gray-300 prose-pre:text-text-main prose-pre:rounded-none
      prose-p:font-serif prose-p:leading-relaxed prose-p:text-text-main text-[15px]">
      <Content />
    </article>
  </main>
</Layout>
