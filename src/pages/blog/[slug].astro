---
import RetroScreenLayout from '../../layouts/RetroScreenLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<RetroScreenLayout title={`RWBU | ${post.data.title}`} activeNav="blog">
  <div style="max-width: 900px; margin: 0 auto; padding: 1.5vh 1vw;">
    <!-- Back Link & Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 3px solid #d6336c; padding-bottom: 1vh; margin-bottom: 1.5vh;" class="mono">
      <a href="/blog" style="border: 3px outset #d6336c; background: #ffffff; color: #a61e4d; padding: 4px 10px; font-weight: bold; text-decoration: none;">
        &lt;- Return to Blog Index
      </a>
      <span style="color: #5b3a9e; font-weight: bold; font-family: serif;">
        Published: {post.data.publishDate} | Read: {post.data.readingTime}
      </span>
    </div>

    <header style="margin-bottom: 1.5vh;">
      <h1 style="font-size: 4.5vh; color: #a61e4d; text-decoration: underline; margin: 0 0 0.8vh 0; line-height: 1.2;">
        {post.data.title}
      </h1>

      {post.data.tags && post.data.tags.length > 0 && (
        <div style="display: flex; flex-wrap: wrap; gap: 6px;" class="mono">
          <span style="color: #5b3a9e; font-weight: bold;">Tags:</span>
          {post.data.tags.map((tag: string) => (
            <span style="padding: 2px 6px; background: #e6f7ec; border: 1px solid #1b7a3a; color: #1b7a3a; font-weight: bold; font-size: 1.6vh;">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Article Content Box -->
    <article style="background: #ffffff; border: 3px solid #5b3a9e; padding: 2vh 2vw; margin-bottom: 2vh; font-size: 2.2vh; line-height: 1.5;">
      <Content />
    </article>

    <!-- Bottom Navigation -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5vh;" class="mono">
      <a href="/blog" style="border: 3px outset #0b6e8a; background: #ffffff; color: #0b6e8a; padding: 6px 14px; font-weight: bold; text-decoration: none;">
        &lt;- Back to Weblog
      </a>
      <a href="/contact" style="border: 3px outset #5b3a9e; background: #ffffff; color: #5b3a9e; padding: 6px 14px; font-weight: bold; text-decoration: none;">
        Send Feedback via Contact -&gt;
      </a>
    </div>
  </div>
</RetroScreenLayout>
