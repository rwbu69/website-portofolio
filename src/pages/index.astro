---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import TechStack from '../components/TechStack.astro';
import Contact from '../components/Contact.astro';
---

<SiteLayout>
  <!-- Minimal Floating Navigation Bar with Pink Progress Indicator -->
  <Navigation />

  <!-- Single-Page Sequential Content Flow -->
  <main id="main-content">
    <!-- Section 0: Introduction & Identity -->
    <Hero />

    <!-- Section 1: Featured & Other Projects Showcase -->
    <Projects />

    <!-- Section 2: Grouped Technical Stack & Workflows -->
    <TechStack />

    <!-- Section 3: Direct Contact Channels & Footer -->
    <Contact />
  </main>
</SiteLayout>
