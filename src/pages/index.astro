---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { getFeaturedProjects } from "../data/projects";
import { getCollection } from "astro:content";
import { identity, experience, allSkillsFlat } from "../data/profile";
import TechIcon from "../components/react/TechIcon";

const featuredProjects = getFeaturedProjects();
const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).valueOf() -
      new Date(a.data.publishDate).valueOf(),
  )
  .slice(0, 3);

const skills = allSkillsFlat;
const currentStatus =
  experience.find((exp) => exp.role.toLowerCase().includes("freelance"))
    ?.duration || "Available for freelance / open to work";
---

<Layout title={`RWBU | ${identity.role}`}>
  <Navbar />

  <main class="max-w-4xl mx-auto px-6 py-12 w-full grow">
    <!-- Introduction Section -->
    <header class="mb-14 border-b border-gray-200 pb-10">
      <div class="mb-6">
        <h1 class="text-3xl md:text-4xl font-serif font-bold text-text-main mb-2">
          Hello, I'm {identity.alias}!
        </h1>
        <p class="text-sm font-mono text-text-muted">
          こんにちは！Web Developer / Otaku / Based in Indonesia
        </p>
      </div>
      
      <p class="text-lg mb-8 max-w-2xl font-serif leading-relaxed text-text-main">
        A frontend developer with over a year of experience, specializing in React and Astro. I love crafting web experiences that are fast, accessible, and of course... look sweet! 
      </p>

      <div class="flex items-center gap-2 text-sm font-mono mb-8 p-3 bg-green/10 border border-green/30 text-green inline-flex">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full bg-green opacity-75"></span>
          <span class="relative inline-flex h-full w-full bg-green"></span>
        </span>
        <span>STATUS: {currentStatus}</span>
      </div>

      <!-- CTA Contact -->
      <div class="font-serif mt-2 flex flex-col md:flex-row gap-4">
        <a href="mailto:sebastianhutagalung69@gmail.com" class="bg-pink text-white text-base font-bold py-2 px-6 border border-pink hover:bg-white hover:text-pink transition-colors text-center rounded-sm">
          Send Email
        </a>
        <a href="https://wa.me/6285172244992?text=I%20would%20like%20to%20order%20a%20website" target="_blank" rel="noopener noreferrer" class="bg-green text-white text-base font-bold py-2 px-6 border border-green hover:bg-white hover:text-green transition-colors text-center rounded-sm">
          WhatsApp Chat
        </a>
      </div>
    </header>

    <div class="space-y-16">
      <!-- Bukti Kerja / Projects Preview -->
      <section>
        <h2 class="text-2xl font-bold mb-6 font-serif text-text-main flex items-baseline gap-3">
          Recent Projects
          <span class="text-sm font-normal text-text-muted font-serif">最近のプロジェクト</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
          {featuredProjects.slice(0,4).map((project) => (
            <div class="p-5 bg-white border border-gray-200 hover:border-pink transition-colors flex flex-col h-full group rounded-sm">
              <div class="flex justify-between items-start mb-3">
                <h3 class="text-lg font-bold group-hover:text-pink transition-colors">
                  <a href={project.demoLink || project.repoLink || `/projects`} class="after:absolute after:inset-0 relative">{project.title}</a>
                </h3>
                <span class={`text-[10px] font-bold font-mono px-2 py-0.5 rounded-sm ${project.status === "completed" || project.status === "live" ? "bg-green/10 text-green" : "bg-yellow/10 text-yellow"}`}>
                  {project.status.toUpperCase()}
                </span>
              </div>
              <p class="text-sm text-text-main mb-4 flex-grow line-clamp-3 leading-relaxed">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2 font-mono text-xs text-text-muted mt-auto pt-4 border-t border-gray-100">
                {project.tech.map((t) => (
                  <span class="bg-gray-50 px-2 py-0.5 border border-gray-200 text-text-muted">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="mt-6 text-right">
          <a href="/projects" class="text-sm font-serif text-text-muted hover:text-pink underline decoration-pink underline-offset-4 transition-colors">View all projects ➝</a>
        </div>
      </section>

      <!-- Skills Directory -->
      <section>
        <h2 class="text-2xl font-bold mb-6 font-serif text-text-main flex items-baseline gap-3">
          Technical Skills
          <span class="text-sm font-normal text-text-muted font-serif">技術的スキル</span>
        </h2>
        <div class="bg-white border border-gray-200 p-6 rounded-sm">
          <div class="flex flex-wrap gap-3">
            {skills.map((skill) => (
              <span class="px-3 py-1 text-sm font-serif bg-gray-50 border border-gray-200 text-text-main hover:border-tosca hover:text-tosca transition-colors flex items-center gap-2 cursor-default rounded-sm">
                <TechIcon tech={skill} className="w-4 h-4" />
                {skill}
              </span>
            ))}
          </div>
        </div>
      </section>

      <!-- Blog Preview -->
      <section>
        <h2 class="text-2xl font-bold mb-6 font-serif text-text-main flex items-baseline gap-3">
          Latest Notes
          <span class="text-sm font-normal text-text-muted font-serif">ブログとメモ</span>
        </h2>
        <div class="bg-white border border-gray-200 rounded-sm overflow-hidden">
          {latestPosts.map((post) => (
            <article class="p-4 border-b border-gray-100 hover:bg-pink/5 transition-colors group relative last:border-0">
              <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4">
                <p class="text-xs font-serif text-text-muted w-32 shrink-0">
                  {post.data.publishDate}
                </p>
                <h3 class="font-bold font-serif text-lg group-hover:text-pink transition-colors">
                  <a href={`/blog/${post.id}`} class="after:absolute after:inset-0">{post.data.title}</a>
                </h3>
              </div>
            </article>
          ))}
          {latestPosts.length === 0 && (
            <div class="p-8 text-center text-text-muted font-serif bg-gray-50">
              No notes yet...
            </div>
          )}
        </div>
        <div class="mt-6 text-right">
          <a href="/blog" class="text-sm font-serif text-text-muted hover:text-pink underline decoration-pink underline-offset-4 transition-colors">Read other posts ➝</a>
        </div>
      </section>
    </div>
  </main>
</Layout>
