---
import RetroScreenLayout from '../layouts/RetroScreenLayout.astro';
import { socials, identity, contactDetails } from '../data/profile';
---

<RetroScreenLayout title="RWBU | Contact Directory" activeNav="contact">
  <div style="max-width: 900px; margin: 0 auto; padding: 1.5vh 1vw;">
    <div style="border-bottom: 3px solid #d6336c; padding-bottom: 1.2vh; margin-bottom: 2vh;">
      <h2 style="font-size: 3.8vh; color: #a61e4d; text-decoration: underline; margin: 0 0 0.5vh 0;">
        Contact Information &amp; Switchboard
      </h2>
      <p style="font-size: 2.1vh; margin: 0.4vh 0; line-height: 1.4;">
        I am currently active and open for freelance contracts, internship roles, and developer work. Choose your preferred communication channel below.
      </p>
    </div>

    <!-- Quick Action Availability Box -->
    <div style="background: #fff3b0; border: 3px solid #b8860b; padding: 1.5vh 2vw; margin-bottom: 2.5vh; text-align: center;">
      <div style="font-size: 1.8vh; font-weight: bold; color: #b8860b; margin-bottom: 4px;" class="mono">
        CURRENT AVAILABILITY STATUS:
      </div>
      <div style="font-size: 2.6vh; font-weight: bold; color: #a61e4d; margin-bottom: 1.2vh;">
        Open for freelance contracts, internship roles, and work
      </div>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px;" class="mono">
        <a
          href={`mailto:${contactDetails.email}`}
          style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border: 3px outset #d6336c; background: #ffffff; color: #a61e4d; font-weight: bold; text-decoration: none; font-size: 1.9vh;"
        >
          <span aria-hidden="true">✉️</span> [ Send Direct Email ]
        </a>
        <a
          href={contactDetails.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border: 3px outset #1b7a3a; background: #ffffff; color: #1b7a3a; font-weight: bold; text-decoration: none; font-size: 1.9vh;"
        >
          <span aria-hidden="true">💬</span> [ Open WhatsApp Chat ]
        </a>
      </div>
    </div>

    <!-- Direct Communication Directory Table -->
    <div style="margin-bottom: 2.5vh;">
      <h3 style="font-size: 2.8vh; color: #0b6e8a; text-decoration: underline; margin: 0 0 1vh 0;">
        Direct Communication Directory
      </h3>
      <table border="2" cellpadding="8" cellspacing="0" width="100%" class="facts" style="border: 3px solid #0b6e8a; width: 100%; border-collapse: collapse; background: #e0f4fa; font-size: 2vh;">
        <tbody>
          <tr>
            <td style="font-weight: bold; background: #ffffff; border: 2px solid #0b6e8a; width: 35%; color: #0b6e8a;">Personal Name:</td>
            <td style="border: 2px solid #0b6e8a; background: #ffffff;">{identity.fullName}</td>
          </tr>
          <tr>
            <td style="font-weight: bold; background: #ffffff; border: 2px solid #0b6e8a; color: #0b6e8a;">Developer Handle:</td>
            <td style="border: 2px solid #0b6e8a; background: #ffffff; font-weight: bold; color: #a61e4d;" class="mono">RWBU</td>
          </tr>
          <tr>
            <td style="font-weight: bold; background: #ffffff; border: 2px solid #0b6e8a; color: #0b6e8a;">Primary Email:</td>
            <td style="border: 2px solid #0b6e8a; background: #ffffff;" class="mono">
              <a href={`mailto:${contactDetails.email}`} style="font-weight: bold; color: #a61e4d; text-decoration: underline;">
                {contactDetails.email}
              </a>
            </td>
          </tr>
          <tr>
            <td style="font-weight: bold; background: #ffffff; border: 2px solid #0b6e8a; color: #0b6e8a;">WhatsApp:</td>
            <td style="border: 2px solid #0b6e8a; background: #ffffff;" class="mono">
              <a href={contactDetails.whatsappUrl} target="_blank" rel="noopener noreferrer" style="color: #1b7a3a; font-weight: bold; text-decoration: underline;">
                Direct WhatsApp Transmission ↗
              </a>
            </td>
          </tr>
          <tr>
            <td style="font-weight: bold; background: #ffffff; border: 2px solid #0b6e8a; color: #0b6e8a;">Timezone &amp; Base:</td>
            <td style="border: 2px solid #0b6e8a; background: #ffffff;">{identity.location} ({contactDetails.timezone})</td>
          </tr>
          <tr>
            <td style="font-weight: bold; background: #ffffff; border: 2px solid #0b6e8a; color: #0b6e8a;">Response Expectation:</td>
            <td style="border: 2px solid #0b6e8a; background: #ffffff;">{contactDetails.responseTime}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Official Social Network Profiles -->
    <div>
      <h3 style="font-size: 2.8vh; color: #5b3a9e; text-decoration: underline; margin: 0 0 1vh 0;">
        Official Social Network Profiles
      </h3>
      <table border="2" cellpadding="8" cellspacing="0" width="100%" class="facts" style="border: 3px solid #5b3a9e; width: 100%; border-collapse: collapse; background: #f0eaff; font-size: 2vh;">
        <tbody>
          {socials.map((social) => (
            <tr style="background: #ffffff;">
              <td style="font-weight: bold; border: 2px solid #5b3a9e; width: 35%; color: #5b3a9e;">{social.name}:</td>
              <td style="border: 2px solid #5b3a9e;" class="mono">
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="font-weight: bold; color: #a61e4d; text-decoration: underline;"
                >
                  {social.url} ↗
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</RetroScreenLayout>
