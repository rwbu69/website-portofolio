---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="404 — Page Not Found | Sebastian Hutagalung (RWBU)">
  <div class="min-h-screen flex items-center justify-center px-6 py-20">
    <div class="max-w-md w-full bg-white rounded-2xl border border-[#eddde6] shadow-soft p-8 text-center">
      <span class="inline-block font-mono text-xs font-semibold px-2.5 py-1 rounded-md bg-[#fdf2f7] border border-[#f8cfdf] text-[#c23373] mb-4">
        404 / Not Found
      </span>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#19141e]">
        Page Not Found
      </h1>

      <p class="mt-3 text-sm text-[#595261] font-body leading-relaxed">
        The page or resource you are looking for does not exist or has been relocated to the single-page portfolio.
      </p>

      <div class="mt-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#19141e] text-white text-sm font-medium hover:bg-[#c23373] transition-colors shadow-soft"
        >
          <span>Return to Portfolio</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</SiteLayout>
