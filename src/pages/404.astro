---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="404 | Command Not Found">
  <Navbar />
  
  <main class="max-w-4xl mx-auto px-6 py-24 w-full flex-grow flex flex-col items-center justify-center text-center">
    <div class="inline-block p-8 bg-white border retro-border relative">
      <div class="absolute top-0 left-0 w-full h-1 bg-pink"></div>
      
      <div class="text-6xl font-bold font-mono text-pink mb-4 flex items-center justify-center gap-4">
        <span>[</span> 404 <span>]</span>
      </div>
      
      <h1 class="text-2xl md:text-3xl font-bold mb-4 text-text-main">
        Command Not Found
      </h1>
      
      <p class="text-text-main mb-8 font-mono max-w-md">
        > The page you are looking for has been moved, deleted, or never existed in the first place.
      </p>
      
      <div class="flex gap-4 justify-center">
        <a href="/" class="px-6 py-2 bg-pink border border-pink text-white hover:bg-white hover:text-pink font-mono transition-colors">
          cd ~
        </a>
        <button onclick="window.history.back()" class="px-6 py-2 bg-transparent border border-gray-300 text-text-muted hover:border-pink hover:text-pink font-mono transition-colors">
          cd ..
        </button>
      </div>
    </div>
  </main>
</Layout>
