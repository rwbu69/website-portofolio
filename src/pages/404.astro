---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="404 | Command Not Found">
  <Navbar />
  
  <main class="max-w-4xl mx-auto px-6 py-24 w-full flex-grow flex flex-col items-center justify-center text-center">
    <div class="inline-block p-10 bg-white border border-gray-200 rounded-sm relative shadow-sm">
      <div class="absolute top-0 left-0 w-full h-1 bg-pink rounded-t-sm"></div>
      
      <div class="text-6xl font-bold font-serif text-pink mb-4 flex items-center justify-center gap-4">
        <span>404</span>
      </div>
      
      <h1 class="text-2xl md:text-3xl font-bold mb-4 text-text-main font-serif">
        Page Not Found
      </h1>
      
      <p class="text-text-muted mb-8 max-w-md mx-auto">
        The page you are looking for has been moved, deleted, or never existed in the first place.
      </p>
      
      <div class="flex gap-4 justify-center">
        <a href="/" class="px-6 py-2 bg-pink border border-pink text-white hover:bg-pink/90 hover:-translate-y-0.5 shadow-sm hover:shadow-md transition-all rounded-sm font-medium">
          Return Home
        </a>
        <button onclick="window.history.back()" class="px-6 py-2 bg-white border border-gray-300 text-text-muted hover:border-pink hover:text-pink transition-colors rounded-sm font-medium">
          Go Back
        </button>
      </div>
    </div>
  </main>
</Layout>
