---
import RetroScreenLayout from '../layouts/RetroScreenLayout.astro';
import RetroProjectList from '../components/retro/RetroProjectList.astro';
import { projects } from '../data/projects';
---

<RetroScreenLayout title="RWBU | Projects Directory" activeNav="projects">
  <div style="max-width: 1200px; margin: 0 auto; padding: 1.5vh 1vw;">
    <div style="border-bottom: 3px solid #d6336c; padding-bottom: 1.2vh; margin-bottom: 2vh;">
      <h2 style="font-size: 3.8vh; color: #a61e4d; text-decoration: underline; margin: 0 0 0.5vh 0;">
        Project Archives &amp; Deployments
      </h2>
      <p style="font-size: 2.1vh; margin: 0.4vh 0; line-height: 1.4;">
        A catalog of production web applications, algorithmic tools, desktop software, and AI experiments developed by RWBU. Use the category tabs below to browse by field.
      </p>
    </div>

    <!-- Interactive Filter and Explorer (Server-Rendered Static Astro Component) -->
    <RetroProjectList projects={projects} />
  </div>
</RetroScreenLayout>
