---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectFilter from '../components/react/ProjectFilter';
import { projects, tools } from '../data/projects';
---

<Layout title="RWBU | Projects">
  <Navbar />
  
  <main class="max-w-4xl mx-auto px-6 py-12 w-full flex-grow">
    <PageHeader 
      title="Projects" 
      description="A collection of my work, experiments, and open-source contributions. Filter by technology to explore specific stacks." 
    />

    <ProjectFilter client:load projects={projects} tools={tools} />
  </main>
</Layout>
